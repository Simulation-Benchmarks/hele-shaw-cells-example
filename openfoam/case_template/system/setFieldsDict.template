FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.air 0
    volVectorFieldValue U (0 0 0)
);

regions
(
    cylinderToCell
    {
        p1 (0 0 {{ initial_condition.bubble_z_min }});
        p2 (0 0 {{ initial_condition.bubble_z_max }});
        radius {{ initial_condition.bubble_radius }};

        fieldValues
        (
            volScalarFieldValue alpha.air 1
        );
    }
);


