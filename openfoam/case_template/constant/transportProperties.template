FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases (air soap);

gapWidth [0 1 0 0 0 0 0] {{ fluids.gapWidth }};

air
{
    transportModel  powerLaw;
    powerLawCoeffs
    {
        nuMax            [ 0 2 -1 0 0 0 0 ] 1;
    	nuMin            [ 0 2 -1 0 0 0 0 ] 1.0e-15;
        k                [ 0 2 -1 0 0 0 0 ] {{ fluids.air.k }};         // flow consistency index
        n                [ 0 0 0  0 0 0 0 ] {{ fluids.air.n }};              // flow behaviour index
    }
    rho             rho [1 -3 0 0 0 0 0] {{ fluids.air.rho }};
}

soap
{
    transportModel  powerLaw;
    powerLawCoeffs
    {
        nuMax            [ 0 2 -1 0 0 0 0 ] 1;
    	nuMin            [ 0 2 -1 0 0 0 0 ] 1.0e-15;
        k                [ 0 2 -1 0 0 0 0 ] {{ fluids.soap.k }};           // flow consistency index
        n                [ 0 0 0  0 0 0 0 ] {{ fluids.soap.n }};              // flow behaviour index
    }
    rho             rho [1 -3 0 0 0 0 0] {{ fluids.soap.rho }};
}

sigma          sigma [1 0 -2  0 0 0 0 ] {{ fluids.sigma }};              // Capillary Coefficient


// ************************************************************************* //
